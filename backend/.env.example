PORT=5000
MONGODB_URI=mongodb://localhost:27017/mediflow
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=change_this_access_secret_for_production
JWT_REFRESH_SECRET=change_this_refresh_secret_for_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# One-time bootstrap credentials (used only with: npm run bootstrap)
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_EMAIL=superadmin@mediflow.com
SUPER_ADMIN_PASSWORD=change_this_in_production
